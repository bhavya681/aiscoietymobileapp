# Public runtime configuration for the SocietyAI mobile app.
#
# Only variables prefixed with EXPO_PUBLIC_ are embedded in the client bundle.
# Never put MongoDB URIs, JWT secrets, Gemini keys, or any other secret here.

# Base URL for the SocietyAI Next.js API (no trailing slash required).
EXPO_PUBLIC_API_URL=https://aiscoietyproject-roan.vercel.app/api

# Optional display override for the society name in the app chrome.
# EXPO_PUBLIC_SOCIETY_NAME=Palm Grove Residency
